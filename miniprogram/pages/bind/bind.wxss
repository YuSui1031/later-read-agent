/* pages/bind/bind.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* 头部样式 */
.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 状态卡片 */
.status-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.status-card.success {
  background: #d4edda;
  border: 1rpx solid #c3e6cb;
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.status-text {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.status-card.success .status-text {
  color: #155724;
}

.status-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.status-card.success .status-desc {
  color: #0c5460;
}

/* 步骤样式 */
.steps {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  background: #667eea;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 操作按钮 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.scan-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  height: 100rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 20rpx rgba(102, 126, 234, 0.3);
}

.manual-btn {
  background: white;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 50rpx;
  height: 100rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.complete-btn {
  background: #34c759;
  color: white;
  border: none;
  border-radius: 50rpx;
  height: 100rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 20rpx rgba(52, 199, 89, 0.3);
}

.back-btn {
  background: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 50rpx;
  height: 100rpx;
  font-size: 32rpx;
}

/* 调试信息 */
.debug-info {
  background: rgba(0, 0, 0, 0.1);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 40rpx;
}

.debug-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.debug-item {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
  font-family: monospace;
  word-break: break-all;
}

.debug-item:last-child {
  margin-bottom: 0;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .container {
    padding: 20rpx;
  }
  
  .title {
    font-size: 40rpx;
  }
  
  .subtitle {
    font-size: 24rpx;
  }
  
  .status-card,
  .steps {
    padding: 30rpx 20rpx;
  }
  
  .step-number {
    width: 50rpx;
    height: 50rpx;
    font-size: 28rpx;
    margin-right: 20rpx;
  }
  
  .step-title {
    font-size: 28rpx;
  }
  
  .step-desc {
    font-size: 24rpx;
  }
  
  .scan-btn,
  .manual-btn,
  .complete-btn,
  .back-btn {
    height: 90rpx;
    font-size: 28rpx;
  }
}