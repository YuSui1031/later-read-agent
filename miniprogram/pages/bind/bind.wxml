<!-- pages/bind/bind.wxml -->
<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">绑定浏览器插件</text>
    <text class="subtitle">扫描插件中的小程序码完成绑定</text>
  </view>

  <!-- 已绑定成功 -->
  <view class="status-card success" wx:if="{{isBound}}">
    <view class="status-icon">✅</view>
    <text class="status-text">绑定成功</text>
    <text class="status-desc">用户ID：{{userIdShort}}</text>
  </view>

  <!-- 等待绑定 -->
  <view class="status-card" wx:else>
    <view class="status-icon">🔗</view>
    <text class="status-text">等待绑定</text>
    <text class="status-desc">请扫描浏览器插件中的二维码</text>
  </view>

  <!-- 操作步骤 -->
  <view class="steps">
    <view class="step">
      <view class="step-number">1</view>
      <view class="step-content">
        <text class="step-title">打开浏览器插件</text>
        <text class="step-desc">点击插件图标，显示小程序码</text>
      </view>
    </view>
    
    <view class="step">
      <view class="step-number">2</view>
      <view class="step-content">
        <text class="step-title">扫描二维码</text>
        <text class="step-desc">使用微信扫描插件中的二维码</text>
      </view>
    </view>
    
    <view class="step">
      <view class="step-number">3</view>
      <view class="step-content">
        <text class="step-title">自动绑定</text>
        <text class="step-desc">扫描后自动完成绑定</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <block wx:if="{{isBound}}">
      <button class="complete-btn" type="primary" bindtap="goToExplore">
        🚀 开始使用
      </button>
    </block>
    <block wx:else>
      <button class="scan-btn" type="primary" bindtap="scanQRCode">
        📷 扫描二维码
      </button>
      <button class="manual-btn" bindtap="manualBind">
        🔗 手动输入
      </button>
      <button class="test-btn" bindtap="testLogin">
        🧪 测试登录
      </button>
    </block>
  </view>

  <!-- 调试信息 -->
  <view class="debug-info" wx:if="{{debug}}">
    <text class="debug-title">调试信息</text>
    <text class="debug-item">绑定状态：{{isBound}}</text>
    <text class="debug-item">Scene：{{scene}}</text>
    <text class="debug-item">Session ID：{{sessionId}}</text>
    <text class="debug-item">用户ID：{{userId}}</text>
  </view>
</view>
