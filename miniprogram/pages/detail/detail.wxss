/* pages/detail/detail.wxss */
.container {
  padding: 30rpx;
  background: #f5f7fa;
  height: auto;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 10rpx; /* 缩小与下方卡片的距离 */
  padding-bottom: 5rpx; /* 减少底部内边距 */
  border-bottom: none; /* 移除底部边框 */
}

/* 标题行，包含标题与收藏 */
.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fav-btn {
  background: none;
  border: none;
  font-size: 36rpx;
  padding: 0 10rpx;
}

/* 分析摘要和时间部分 */
.content-section {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  /* 将间距从 20rpx 减小到 12rpx */
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  margin-right: 15rpx;
}

.time-text {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  text-align: justify;
  padding-top: 5rpx;
}

/* 分类标签部分 - 与其他section宽度一致 */
.categories-section {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  /* 将间距从 20rpx 减小到 12rpx */
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  width: 100%;  /* 确保宽度一致 */
  box-sizing: border-box;  /* 包含padding在宽度内 */
}

.categories {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  width: 100%;  /* 确保100%宽度 */
}

.category-tag {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(7, 193, 96, 0.3);
  display: inline-block;
  white-space: nowrap;  /* 防止文字换行 */
  max-width: 100%;  /* 防止溢出 */
  overflow: hidden;  /* 防止溢出 */
  text-overflow: ellipsis;  /* 文字溢出显示... */
}

/* URL部分 */
.url-section {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  /* 为顶部添加负边距，与上方卡片更贴近 */
  margin-top: -4rpx;
  /* 可以保留底部间距，因为下方可能有按钮，也可以调小 */
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.url-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
}

.url-content {
  font-size: 26rpx;
  color: #576b95;
  line-height: 1.6;
  word-break: break-all;
  padding: 15rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  border-left: 4rpx solid #576b95;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  position: fixed;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
}

.copy-btn, .view-btn {
  flex: 1;
  height: 80rpx;
  /* 移除 line-height，改用 flex 居中 */
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  /* 添加以下 flex 属性来居中文字 */
  display: flex;
  align-items: center;
  justify-content: center;
  /* 确保内边距不影响布局 */
  padding: 0;
  /* 重置按钮默认背景，让渐变生效 */
  background: transparent;
}

.copy-btn {
  background: linear-gradient(45deg, #f0f0f0, #e0e0e0);
  color: #666;
}

.view-btn {
  background: linear-gradient(45deg, #07c160, #0ba64c);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

/* 新的主卡片样式，它替代了原来三个section的独立卡片 */
.main-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  /* 这是卡片与下方按钮的唯一间隔，可根据需要调整 */
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

/* 内部模块：移除它们独立的边距、背景、阴影和内边距 */
.content-section, .categories-section, .url-section {
  /* 清除独立卡片样式 */
  margin-bottom: 0;
  box-shadow: none;
  background: transparent;
  padding: 0;
  border-radius: 0;
  width: auto;
  box-sizing: border-box;
}
/* 特别注意：移除 URL 部分之前为贴近上方卡片设置的负边距 */
.url-section {
  margin-top: 0;
}

/* 内部模块之间的分割线 */
.inner-divider {
  height: 1rpx;
  background: #f0f0f0;
  /* 这个数值控制模块间的间距，可调（如 20rpx-30rpx） */
  margin: 25rpx 0;
}