<!-- pages/history/history.wxml -->
<view class="container">
  <view wx:if="{{results.length > 0}}" class="results-list">
    <view wx:for="{{results}}" wx:key="item.task_id" class="result-item" bindtap="navigateToDetail" data-taskid="{{item.task_id || item.id}}">
      <text class="title">{{item.title}}</text>
      <text class="description">{{item.description}}</text>
    </view>
    <button class="clear-btn" bindtap="clearHistory">清空历史</button>
  </view>
  <view wx:else class="empty">
    <text>暂无历史记录</text>
  </view>
</view>