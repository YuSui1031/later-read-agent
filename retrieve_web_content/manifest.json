{
    "manifest_version": 3,
    "name": "AI网页分析助手",
    "version": "1.0",
    "description": "提取网页内容并AI分析，支持批量提取和历史记录",
    "permissions": ["activeTab", "scripting", "storage", "tabs"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "host_permissions": [
        "http://127.0.0.1:*/*",
        "https://*/*"
    ]
}